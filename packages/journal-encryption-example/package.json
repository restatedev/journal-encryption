{
  "name": "journal-encryption-example",
  "type": "commonjs",
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 ./src/index.ts",
    "zip": "zip -j lambda.zip dist/index.js",
    "update": "aws lambda update-function-code --zip-file fileb://lambda.zip --function-name journal-encryption-server",
    "deploy": "run-s build zip update",
    "dev": "tsx --watch src/index.ts",
    "cdk:diff": "cdk diff --app 'tsx bin/server.ts'",
    "cdk:deploy": "cdk diff --app 'tsx bin/server.ts'",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "aws-cdk": "^2.1024.0",
    "aws-cdk-lib": "^2.211.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.9",
    "npm-run-all2": "^6.2.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.0.0"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "^1.8.0",
    "@restatedev/restate-sdk-zod": "^1.8.0",
    "@restatedev/journal-encryption-lib": "^1.0.0",
    "@aws-sdk/client-kms": "^3.864.0",
    "zod": "^3.22.4"
  }
}
